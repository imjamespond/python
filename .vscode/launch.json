{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "test neo4j",
      "program": "${workspaceFolder}/neo4j-mcp-server/test.js",
      "cwd": "${workspaceFolder}/neo4j-mcp-server",
      "runtimeArgs": ["--env-file=.env"],
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "main",
      "type": "debugpy",
      "request": "launch",
      "program": "main.py", // "${file}",
      "args": ["input.txt"],
      "console": "integratedTerminal",
      "justMyCode": false, // 必须关闭以调试库内部的异步调用
      "subProcess": true // 如果你的 asyncio 创建了子任务
    },
    {
      "name": "polyphonic",
      "type": "debugpy",
      "request": "launch",
      "program": "polyphonic.py", // "${file}",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false, // 必须关闭以调试库内部的异步调用
      "subProcess": true // 如果你的 asyncio 创建了子任务
    },
    {
      "name": "file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false, // 必须关闭以调试库内部的异步调用
      "subProcess": true // 如果你的 asyncio 创建了子任务
    }
  ]
}
